[Unit]
Description=Raccoon RDP Proxy (clientAddress rewrite / CredSSP bridge)
After=network-online.target
Wants=network-online.target

[Service]
# AddSystemd() により sd_notify(READY=1) を送るので Type=notify。
# AddSystemd() sends sd_notify(READY=1), hence Type=notify.
Type=notify
# 1インスタンスで複数ターゲットを捌ける。appsettings.json の Proxy:Maps に複数 map・資格情報を記載。
# 設定(appsettings.json)/証明書(proxy.pfx)/ログ(Log/) はこの WorkingDirectory から解決される。
# A single instance handles multiple targets; list the maps and credentials in Proxy:Maps of appsettings.json.
# Config (appsettings.json) / certificate (proxy.pfx) / logs (Log/) resolve from this WorkingDirectory.
WorkingDirectory=/opt/raccoon-rdpproxy
ExecStart=/opt/raccoon-rdpproxy/Raccoon.RdpProxy
Restart=on-failure
RestartSec=3

# ── サービス安定化のための設定 ──
# ── Settings for service stability ──
# FD 上限(サービス既定はターミナルより低いことがある。ソケット枯渇での切断を防ぐ)
# FD limit (the service default can be lower than a terminal's; prevents disconnects from socket exhaustion)
LimitNOFILE=65536

# ログ量は appsettings.json の Serilog:MinimumLevel で調整(既定 Information=静か)。
# 接続/CredSSP/書き換えの各ステップまで見たいときは Debug にする。
# 待受は高ポートなので root 不要。source(例 192.168.50.254) を bind できるホストで実行すること。
# 資格情報を含むため権限を絞る: chmod 600 /opt/raccoon-rdpproxy/appsettings.json
# Log volume is tuned with Serilog:MinimumLevel in appsettings.json (default Information = quiet).
# Set it to Debug to see each connection/CredSSP/rewrite step.
# Listening uses high ports so root is not required. Run on a host that can bind source (e.g. 192.168.50.254).
# Tighten permissions since it holds credentials: chmod 600 /opt/raccoon-rdpproxy/appsettings.json
# User=rdpproxy
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/raccoon-rdpproxy
ProtectHome=true
PrivateTmp=true

# ── バイナリについて / About the binary ──
# 配布物は NativeAOT 版(build-aot.bat で生成)を前提とする。JIT も単一ファイルの展開も無いため、
# SELinux enforcing 下でも execmem/execheap を要求せず、そのまま起動できる。
# The expected artifact is the NativeAOT build (produced by build-aot.bat). It has neither JIT nor
# single-file extraction, so it needs no execmem/execheap and starts as-is even under SELinux enforcing.
#   build-aot.bat  ->  publish/aot-linux-x64/Raccoon.RdpProxy を /opt/raccoon-rdpproxy へ配置
#   build-aot.bat  ->  deploy publish/aot-linux-x64/Raccoon.RdpProxy to /opt/raccoon-rdpproxy

[Install]
WantedBy=multi-user.target
